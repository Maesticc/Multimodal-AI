# Copy to .env and edit. No credentials are needed: everything runs locally.
# All values below are the defaults used for the saved example outputs.

# --- Data / index ---
RAG_DATA_DIR=data
RAG_SOURCES_FILE=data/sources.json
RAG_INDEX_DIR=index
RAG_LOG_DIR=logs
RAG_COLLECTION=papers

# --- Ingestion (characters) ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MIN_CHUNK_CHARS=300
RAG_INCLUDE_REFERENCES=false

# --- Embeddings (sentence-transformers, downloaded from Hugging Face on first run) ---
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# cpu | cuda  (cuda needs a CUDA build of PyTorch)
RAG_EMBED_DEVICE=cpu

# --- Retrieval ---
# dense | bm25 | hybrid
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_RRF_K=60

# --- Generation ---
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
RAG_TEMPERATURE=0.0
RAG_SEED=42
RAG_NUM_CTX=4096
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_ANSWER_TOKENS=512
RAG_REQUEST_TIMEOUT=300
